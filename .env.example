# Variables de entorno para build-config.js
# Copiar a .env y completar con valores reales (NO COMMITEAR .env)

# URL de tu proyecto Supabase (formato: https://<project-id>.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Anon/Public key de Supabase (Settings > API > Project API keys)
SUPABASE_ANON_KEY=your-anon-key-here

# Opcional: versión para el Service Worker (hardcodeada en sw.js: '1.3.0')
# Descomentar si quieres sobreescribir la versión desde .env
# ENOTE_VERSION=1.3.0
